MOFI_ENVIRONMENT=local
MOFI_LOG_LEVEL=INFO
MOFI_HOST=0.0.0.0
MOFI_PORT=8080
MOFI_DATABASE_DSN=postgresql://mofiagent:mofiagent@localhost:5432/mofiagent
MOFI_MIGRATIONS_DIR=migrations
MOFI_DB_POOL_MIN_SIZE=1
MOFI_DB_POOL_MAX_SIZE=4
MOFI_DB_CONNECT_TIMEOUT_SECONDS=5
MOFI_DB_STARTUP_TIMEOUT_SECONDS=30
MOFI_DB_POOL_TIMEOUT_SECONDS=5
MOFI_GOOGLE_CLOUD_PROJECT=
MOFI_GOOGLE_CLOUD_LOCATION=us
MOFI_VERTEX_MODEL=gemini-3.5-flash
MOFI_MAX_AGENT_ROUNDS=4
MOFI_REQUEST_TIMEOUT_SECONDS=20
MOFI_QUESTION_DEADLINE_SECONDS=90
MOFI_SESSION_LEASE_SECONDS=150
