#!/bin/bash
set -euo pipefail

exec > >(logger -t mofiagent-database) 2>&1

readonly DATA_DEVICE="${data_device}"
readonly DATA_MOUNT="${data_mount}"

for attempt in $(seq 1 60); do
  if [[ -b "$${DATA_DEVICE}" ]]; then
    break
  fi
  if [[ "$${attempt}" -eq 60 ]]; then
    echo "Database data disk did not appear"
    exit 1
  fi
  sleep 2
done

if ! blkid "$${DATA_DEVICE}" >/dev/null 2>&1; then
  mkfs.ext4 -m 0 -F -E lazy_itable_init=0,lazy_journal_init=0,discard "$${DATA_DEVICE}"
fi

mkdir -p "$${DATA_MOUNT}"
if ! mountpoint -q "$${DATA_MOUNT}"; then
  mount -o discard,defaults "$${DATA_DEVICE}" "$${DATA_MOUNT}"
fi
chown 70:70 "$${DATA_MOUNT}"
chmod 0700 "$${DATA_MOUNT}"

access_token() {
  curl --fail --silent --show-error \
    --header "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | sed -nE 's/.*"access_token"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p'
}

read_secret() {
  local secret_id="$1"
  local token
  token="$(access_token)"
  curl --fail --silent --show-error \
    --header "Authorization: Bearer $${token}" \
    "https://secretmanager.googleapis.com/v1/projects/${project_id}/secrets/$${secret_id}/versions/latest:access" \
    | sed -nE 's/.*"data"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' \
    | base64 --decode
}

ADMIN_PASSWORD="$(read_secret "${admin_password_secret_id}")"
API_PASSWORD="$(read_secret "${api_password_secret_id}")"
INGEST_PASSWORD="$(read_secret "${ingest_password_secret_id}")"

if [[ -z "$${ADMIN_PASSWORD}" || -z "$${API_PASSWORD}" || -z "$${INGEST_PASSWORD}" ]]; then
  echo "One or more database credentials could not be loaded"
  exit 1
fi

docker pull "${timescaledb_image}"
docker rm --force mofiagent-timescaledb >/dev/null 2>&1 || true
docker run --detach \
  --name mofiagent-timescaledb \
  --restart always \
  --network host \
  --volume "$${DATA_MOUNT}:/var/lib/postgresql/data" \
  --env POSTGRES_DB="${database_name}" \
  --env POSTGRES_USER="${admin_user}" \
  --env POSTGRES_PASSWORD="$${ADMIN_PASSWORD}" \
  --health-cmd="pg_isready -U ${admin_user} -d ${database_name}" \
  --health-interval=10s \
  --health-timeout=5s \
  --health-retries=12 \
  --log-driver=gcplogs \
  "${timescaledb_image}" \
  -c listen_addresses='*' \
  -c password_encryption=scram-sha-256 \
  -c max_connections=50 \
  -c shared_buffers=256MB

for attempt in $(seq 1 60); do
  if docker exec mofiagent-timescaledb pg_isready -U "${admin_user}" -d "${database_name}"; then
    break
  fi
  if [[ "$${attempt}" -eq 60 ]]; then
    echo "TimescaleDB did not become ready"
    exit 1
  fi
  sleep 2
done

readonly ROLE_SQL="/run/mofiagent-roles.sql"
cat >"$${ROLE_SQL}" <<'SQL'
SELECT 'CREATE ROLE ${api_user} LOGIN'
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${api_user}') \gexec
SELECT 'CREATE ROLE ${ingest_user} LOGIN'
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${ingest_user}') \gexec

ALTER ROLE ${api_user} WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'api_password';
ALTER ROLE ${ingest_user} WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD :'ingest_password';
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT CONNECT ON DATABASE ${database_name} TO ${api_user}, ${ingest_user};
GRANT USAGE ON SCHEMA public TO ${api_user}, ${ingest_user};
SQL
chmod 0600 "$${ROLE_SQL}"

docker exec \
  --env PGPASSWORD="$${ADMIN_PASSWORD}" \
  --interactive mofiagent-timescaledb \
  psql \
  --username "${admin_user}" \
  --dbname "${database_name}" \
  --set ON_ERROR_STOP=1 \
  --set api_password="$${API_PASSWORD}" \
  --set ingest_password="$${INGEST_PASSWORD}" \
  <"$${ROLE_SQL}"

shred --remove "$${ROLE_SQL}" || rm --force "$${ROLE_SQL}"
unset ADMIN_PASSWORD API_PASSWORD INGEST_PASSWORD
echo "TimescaleDB startup completed"
